{
  "definitions": [
    {
      "title": "Cards – Stats",
      "id": "cards-stats",
      "model": "cards-stats",
      "filter": "cards-stats",
      "plugins": {
        "da": {
          "name": "cards-stats",
          "rows": 1,
          "columns": 2,
          "fields": [
            {
              "name": "header",
              "selector": "div:first-child:has(h1,h2,h3,h4,h5,h6)>div"
            },
            {
              "name": "cta",
              "selector": "div:last-child:not(:first-child):has(>div:only-child a:only-child)>div"
            }
          ]
        }
      }
    },
    {
      "title": "Stat",
      "id": "cards-stats-item",
      "model": "cards-stats-item",
      "plugins": {
        "da": {
          "name": "cards-stats-item",
          "rows": 1,
          "columns": 2,
          "fields": [
            {
              "name": "figure",
              "selector": "div:first-child:not(:last-child)"
            },
            {
              "name": "caption",
              "selector": "div:last-child"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards-stats",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Options",
          "valueType": "string",
          "options": [
            {
              "name": "Panel (rounded container, header row and CTA row)",
              "value": "panel"
            },
            {
              "name": "Sky tint 5% background",
              "value": "tint-sky-5"
            }
          ]
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "header",
          "label": "Panel heading and intro (first row, panel only)",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "cta",
          "label": "Panel CTA link (last row, panel only)",
          "value": ""
        }
      ]
    },
    {
      "id": "cards-stats-item",
      "fields": [
        {
          "component": "richtext",
          "valueType": "string",
          "name": "figure",
          "label": "Figure (e.g. 100%)",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "caption",
          "label": "Caption",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards-stats",
      "components": [
        "cards-stats-item"
      ]
    }
  ]
}
