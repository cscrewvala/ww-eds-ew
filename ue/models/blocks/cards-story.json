{
  "definitions": [
    {
      "title": "Cards – Story",
      "id": "cards-story",
      "model": "cards-story",
      "filter": "cards-story",
      "plugins": {
        "da": {
          "name": "cards-story",
          "rows": 1,
          "columns": 2
        }
      }
    },
    {
      "title": "Story Card",
      "id": "cards-story-item",
      "model": "cards-story-item",
      "plugins": {
        "da": {
          "name": "cards-story-item",
          "rows": 1,
          "columns": 2,
          "fields": [
            {
              "name": "image",
              "selector": "div:nth-child(1) picture>img[src]"
            },
            {
              "name": "imageAlt",
              "selector": "div:nth-child(1) picture>img[alt]"
            },
            {
              "name": "imageLink",
              "selector": "div:nth-child(1) a[href*=\"/is/image/\"]"
            },
            {
              "name": "text",
              "selector": "div:nth-child(2)"
            }
          ]
        }
      }
    }
  ],
