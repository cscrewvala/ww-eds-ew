{
  "definitions": [
    {
      "title": "Carousel – Hero",
      "id": "carousel-hero",
      "model": "carousel-hero",
      "filter": "carousel-hero",
      "plugins": {
        "da": {
          "name": "carousel-hero",
          "rows": 1,
          "columns": 2
        }
      }
    },
    {
      "title": "Slide",
      "id": "carousel-hero-item",
      "model": "carousel-hero-item",
      "plugins": {
        "da": {
          "name": "carousel-hero-item",
          "rows": 1,
          "columns": 2,
          "fields": [
            {
              "name": "image",
              "selector": "div:nth-child(1)"
            },
            {
              "name": "text",
              "selector": "div:nth-child(2)"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "carousel-hero",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Options",
          "options": [
            {
              "name": "gradient",
              "value": "gradient"
            },
            {
              "name": "no-overlay",
              "value": "no-overlay"
            },
            {
              "name": "hide-controls",
              "value": "hide-controls"
            }
          ]
        }
      ]
    },
    {
      "id": "carousel-hero-item",
      "fields": [
        {
          "component": "richtext",
          "name": "image",
          "label": "Image",
          "valueType": "string",
          "description": "Scene7 image link (link URL = image, link text = alt text). Edit the link to change the image."
        },
        {
          "component": "richtext",
          "name": "text",
          "label": "Text (optional video link first)",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "carousel-hero",
      "components": [
        "carousel-hero-item"
      ]
    }
  ]
}
