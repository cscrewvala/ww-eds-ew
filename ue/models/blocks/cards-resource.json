{
  "definitions": [
    {
      "title": "Cards – Resource",
      "id": "cards-resource",
      "model": "cards-resource",
      "filter": "cards-resource",
      "plugins": {
        "da": {
          "name": "cards-resource",
          "rows": 1,
          "columns": 2
        }
      }
    },
    {
      "title": "Resource Card",
      "id": "cards-resource-item",
      "model": "cards-resource-item",
      "plugins": {
        "da": {
          "name": "cards-resource-item",
          "rows": 1,
          "columns": 2,
          "fields": [
            {
              "name": "image",
              "selector": "div:nth-child(1) picture>img[src]"
            },
            {
              "name": "imageAlt",
              "selector": "div:nth-child(1) picture>img[alt]"
            },
            {
              "name": "imageLink",
              "selector": "div:nth-child(1) a[href*=\"/is/image/\"]"
            },
            {
              "name": "text",
              "selector": "div:nth-child(2)"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards-resource",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Options",
          "valueType": "string",
          "options": [
            {
              "name": "Document frames",
              "value": "documents"
            }
          ]
        }
      ]
    },
    {
      "id": "cards-resource-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Icon",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Icon alt text",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageLink",
          "label": "Image URL (Scene7)",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Title, description and link",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards-resource",
      "components": [
        "cards-resource-item"
      ]
    }
  ]
}
