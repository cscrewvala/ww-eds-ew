{
  "definitions": [
    {
      "title": "Cards – Timeline",
      "id": "cards-timeline",
      "model": "cards-timeline",
      "filter": "cards-timeline",
      "plugins": {
        "da": {
          "name": "cards-timeline",
          "rows": 1,
          "columns": 4
        }
      }
    },
    {
      "title": "Milestone",
      "id": "cards-timeline-item",
      "model": "cards-timeline-item",
      "plugins": {
        "da": {
          "name": "cards-timeline-item",
          "rows": 1,
          "columns": 4,
          "fields": [
            {
              "name": "variant",
              "selector": "div:nth-child(1)"
            },
            {
              "name": "year",
              "selector": "div:nth-child(2)"
            },
            {
              "name": "text",
              "selector": "div:nth-child(3)"
            },
            {
              "name": "image",
              "selector": "div:nth-child(4) picture>img[src]"
            },
            {
              "name": "imageAlt",
              "selector": "div:nth-child(4) picture>img[alt]"
            },
            {
              "name": "imageLink",
              "selector": "div:nth-child(4) a[href*=\"/is/image/\"]"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards-timeline",
      "fields": []
    },
    {
      "id": "cards-timeline-item",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "variant",
          "label": "Band colour and side",
          "options": [
            {
              "name": "Midnight band, card left",
              "value": "midnight"
            },
            {
              "name": "Midnight band, card right",
              "value": "midnight, right"
            },
            {
              "name": "Sky band, card left",
              "value": "sky"
            },
            {
              "name": "Sky band, card right",
              "value": "sky, right"
            },
            {
              "name": "Ocean band, card left",
              "value": "ocean"
            },
            {
              "name": "Ocean band, card right",
              "value": "ocean, right"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "year",
          "label": "Year",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Title and text",
          "value": ""
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image alt text",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageLink",
          "label": "Image URL (Scene7)",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards-timeline",
      "components": [
        "cards-timeline-item"
      ]
    }
  ]
}
